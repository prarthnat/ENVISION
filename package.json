{
  "name": "envision-studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "seed": "npm run seed --workspace=server",
    "migrate": "npm run migrate --workspace=server"
  },
  "prisma": {
    "seed": "node server/prisma/seed.js"
  }
}
